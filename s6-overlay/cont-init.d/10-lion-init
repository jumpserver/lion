#!/command/with-contenv sh

set -eu

if [ -n "${CORE_HOST:-}" ]; then
    until check "${CORE_HOST}/api/health/"; do
        echo "wait for jms_core ${CORE_HOST} ready"
        sleep 2
    done
fi

# Set timezone according to the TZ environment variable, if it is set and valid
if [ -n "${TZ:-}" ] && [ -e "/usr/share/zoneinfo/${TZ}" ]; then
    ln -sf "/usr/share/zoneinfo/${TZ}" /etc/localtime
fi

mkdir -p /opt/lion/data/logs/guacd

if [ -e /opt/lion/data/logs/guacd.log ] || [ -L /opt/lion/data/logs/guacd.log ]; then
    mv /opt/lion/data/logs/guacd.log "/opt/lion/data/logs/guacd.log.$(date +%Y%m%d%H%M%S).bak"
fi

: "${LOG_LEVEL:=ERROR}"

case "${LOG_LEVEL}" in
    DEBUG)
        level="debug"
        ;;
    INFO)
        level="info"
        ;;
    WARN)
        level="warning"
        ;;
    ERROR|FATAL|CRITICAL)
        level="error"
        ;;
    *)
        level="error"
        ;;
esac

export GUACD_LOG_LEVEL="${level}"
printf '%s' "${GUACD_LOG_LEVEL}" > /run/s6/container_environment/GUACD_LOG_LEVEL

echo
date
echo "LION Version ${VERSION}, more see https://www.jumpserver.org"
echo "Quit the server with CONTROL-C."
echo
